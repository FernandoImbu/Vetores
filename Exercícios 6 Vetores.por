programa
{
	
	funcao inicio()
	{
		inteiro numeros[10], salvar[10]
		para(inteiro i = 0; i < 10; i++){
		escreva("Informe o valor o valor da posição"+i+" do vetor:")
			leia(numeros[i])
			salvar[i] = numeros[i]}
	numeros[0] = (numeros[0] / numeros[0]) * salvar[9] 
	numeros[1] = (numeros[1] / numeros[1]) * salvar[8]
	numeros[2] = (numeros[2] / numeros[2]) * salvar[7]
	numeros[3] = (numeros[3] / numeros[3]) * salvar[6]
	numeros[4] = (numeros[4] / numeros[4]) * salvar[5]
	numeros[5] = (numeros[5] / numeros[5]) * salvar[4]
	numeros[6] = (numeros[6] / numeros[6]) * salvar[3]
	numeros[7] = (numeros[7] / numeros[7]) * salvar[2]
	numeros[8] = (numeros[8] / numeros[8]) * salvar[1]
	numeros[9] = (numeros[9] / numeros[9]) * salvar[0]
	para(inteiro i=0; i < 10; i++){
		escreva(numeros[i]+"  ")
		}
	}
	
	
}
